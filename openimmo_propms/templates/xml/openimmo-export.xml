<?xml version="1.0" encoding="UTF-8"?>
<!--
    OpenImmo $VERSION: 1.2.7  6/2014
    (c) OpenImmo e.V.
    Standard OpenImmo XML Template for Export
    Refined based on OpenEstate-IO Master Rules
-->

<openimmo>

    <uebertragung
        art="ONLINE"
        umfang="{{ uebertragung.umfang }}"
        modus="{{ uebertragung.modus }}"
        version="1.2.7"
        sendersoftware="OIGEN"
        senderversion="1.0"
        techn_email="{{ uebertragung.techn_email }}"
        timestamp="{{ uebertragung.timestamp }}"
        regi_id="{{ uebertragung.regi_id }}"
        portal="{{ uebertragung.portal }}"
    />

    <anbieter>

        <anbieternr>{{ anbieter.anbieternr }}</anbieternr>
        <firma>{{ anbieter.firma }}</firma>
        <openimmo_anid>{{ anbieter.openimmo_anid }}</openimmo_anid>
        <lizenzkennung>{{ anbieter.lizenzkennung }}</lizenzkennung>

        <!-- Objekt Blueprint -->
        <immobilie>

            <objektkategorie>
                <nutzungsart />
                <vermarktungsart />
                <objektart />
                <user_defined_simplefield feldname=""/>
                <user_defined_anyfield/>
            </objektkategorie>

            <!-- Geo Informationen -->
            <geo>
                <plz>{{ geo.plz }}</plz>
                <ort>{{ geo.ort }}</ort>
                <geokoordinaten
                    breitengrad="{{ geo.geokoordinaten.breitengrad }}"
                    laengengrad="{{ geo.geokoordinaten.laengengrad }}"
                />
                <strasse>{{ geo.strasse }}</strasse>
                <hausnummer>{{ geo.hausnummer }}</hausnummer>
                <bundesland>{{ geo.bundesland }}</bundesland>
                <land iso_land="{{ geo.land.iso_land }}" />
                <user_defined_simplefield feldname=""/>
                <user_defined_anyfield/>
                <user_defined_extend/>
            </geo>

            <!-- Kontaktperson -->
            <kontaktperson>
                <email_zentrale>{{ kontaktperson.email_zentrale }}</email_zentrale>
                <email_direkt>{{ kontaktperson.email_direkt }}</email_direkt>
                <tel_zentrale>{{ kontaktperson.tel_zentrale }}</tel_zentrale>
                <tel_durchw>{{ kontaktperson.tel_durchw }}</tel_durchw>
                <tel_fax>{{ kontaktperson.tel_fax }}</tel_fax>
                <tel_handy>{{ kontaktperson.tel_handy }}</tel_handy>
                <name>{{ kontaktperson.name }}</name>
                <vorname>{{ kontaktperson.vorname }}</vorname>
                <anrede>{{ kontaktperson.anrede }}</anrede>
                <land iso_land="{{ kontaktperson.land.iso_land }}" />
                <foto location="EXTERN">
                    <format />
                    <daten><pfad /></daten>
                </foto>
                <user_defined_simplefield feldname=""/>
                <user_defined_anyfield/>
                <user_defined_extend/>
            </kontaktperson>

            <weitere_adresse adressart="">
                <vorname/>
                <name/>
                <land />
            </weitere_adresse>

            <!-- Preise -->
            <preise>
                <kaltmiete>{{ preise.kaltmiete }}</kaltmiete>
                <warmmiete>{{ preise.warmmiete }}</warmmiete>
                <nebenkosten>{{ preise.nebenkosten }}</nebenkosten>
                <waehrung iso_waehrung="{{ preise.waehrung }}" />
                <kaution>{{ preise.kaution }}</kaution>
                <kaution_text>{{ preise.kaution_text }}</kaution_text>
                <user_defined_simplefield feldname=""/>
                <user_defined_anyfield/>
                <user_defined_extend/>
            </preise>

            <bieterverfahren />
            <versteigerung />

            <!-- Flaechen -->
            <flaechen>
                <wohnflaeche>{{ flaechen.wohnflaeche }}</wohnflaeche>
                <anzahl_zimmer>{{ flaechen.anzahl_zimmer }}</anzahl_zimmer>
                <anzahl_schlafzimmer>{{ flaechen.anzahl_schlafzimmer }}</anzahl_schlafzimmer>
                <anzahl_badezimmer>{{ flaechen.anzahl_badezimmer }}</anzahl_badezimmer>
                <user_defined_simplefield feldname=""/>
                <user_defined_anyfield/>
                <user_defined_extend/>
            </flaechen>

            <!-- Ausstattung -->
            <ausstattung>
                <bad />
                <kueche />
                <boden />
                <heizungsart />
                <befeuerung />
                <fahrstuhl />
                <moebliert />
                <unterkellert />
                <user_defined_simplefield feldname=""/>
                <user_defined_anyfield/>
                <user_defined_extend/>
            </ausstattung>

            <!-- Zustand -->
            <zustand_angaben>
                <baujahr>{{ zustand_angaben.baujahr }}</baujahr>
                <zustand />
                <energiepass />
                <user_defined_simplefield feldname=""/>
                <user_defined_anyfield/>
                <user_defined_extend/>
            </zustand_angaben>

            <bewertung />

            <infrastruktur>
                <ausblick />
                <user_defined_simplefield feldname=""/>
                <user_defined_anyfield/>
                <user_defined_extend/>
            </infrastruktur>

            <!-- Freitexte -->
            <freitexte>
                <objekttitel>{{ freitexte.objekttitel }}</objekttitel>
                <lage>{{ freitexte.lage }}</lage>
                <ausstatt_beschr>{{ freitexte.ausstatt_beschr }}</ausstatt_beschr>
                <objektbeschreibung>{{ freitexte.objektbeschreibung }}</objektbeschreibung>
                <sonstige_angaben>{{ freitexte.sonstige_angaben }}</sonstige_angaben>
            </freitexte>

            <!-- Anhaenge -->
            <anhaenge>
                <anhang location="EXTERN" gruppe="TITELBILD">
                    <anhangtitel/>
                    <format/>
                    <daten><pfad/></daten>
                </anhang>
            </anhaenge>

            <verwaltung_objekt />

            <!-- Technische Verwaltung -->
            <verwaltung_techn>
                <objektnr_intern>{{ verwaltung_techn.objektnr_intern }}</objektnr_intern>
                <objektnr_extern>{{ verwaltung_techn.objektnr_extern }}</objektnr_extern>
                <aktion />
                <verfuegbar_ab>{{ verwaltung_techn.verfuegbar_ab }}</verfuegbar_ab>
            </verwaltung_techn>

            <user_defined_simplefield feldname=""/>
            <user_defined_anyfield/>
            <user_defined_extend/>

        </immobilie>

    </anbieter>

</openimmo>
